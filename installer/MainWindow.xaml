<Window x:Class="Hivecraft.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Hivecraft Setup" Width="940" Height="680" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}"
        FontFamily="{StaticResource Sans}" Foreground="{StaticResource Text}"
        WindowStyle="None" ResizeMode="CanResize" Icon="hive.ico" TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Border x:Name="Frame" Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="46"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- title bar -->
      <Border Grid.Row="0" Background="#0C1017" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
        <Grid>
          <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
            <Image Source="hive.png" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="HIVECRAFT" Margin="11,0,0,0" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Amber}" VerticalAlignment="Center">
              <TextBlock.Effect><DropShadowEffect Color="#FFB547" Opacity="0.35" BlurRadius="10" ShadowDepth="0"/></TextBlock.Effect>
            </TextBlock>
            <TextBlock x:Name="TitleMode" Text="SETUP" Margin="8,1,0,0" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource Caption}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Min_Click" ToolTip="Minimize">
              <Path Data="M0,0 L10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/>
            </Button>
            <Button Style="{StaticResource CaptionClose}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click" ToolTip="Close">
              <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="210"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- step rail -->
        <Border Background="#0B0F15" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
          <ItemsControl x:Name="Rail" Margin="14,22,10,10">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,4">
                  <Border CornerRadius="8" Padding="10,8" Background="{Binding Bg}">
                    <StackPanel Orientation="Horizontal">
                      <Border Width="22" Height="22" CornerRadius="11" Background="{Binding DotBg}" BorderBrush="{Binding DotLine}" BorderThickness="1.5">
                        <TextBlock Text="{Binding Mark}" FontSize="11" FontWeight="Bold" Foreground="{Binding DotFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <TextBlock Text="{Binding Title}" Margin="10,0,0,0" FontSize="13" Foreground="{Binding Fg}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Border>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <!-- pages -->
        <ScrollViewer Grid.Column="1" x:Name="PageScroll" VerticalScrollBarVisibility="Auto" Padding="34,26,34,20">
          <Grid x:Name="Pages">

            <!-- WELCOME -->
            <StackPanel x:Name="pWelcome">
              <TextBlock Style="{StaticResource H1}" Text="Welcome to Hivecraft"/>
              <TextBlock Style="{StaticResource Lead}" Text="Hivecraft runs a small team of AI agents that each play their own Minecraft character. They talk to each other, split up jobs and build things together — and you join the same world and tell them what to do in chat."/>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Style="{StaticResource Label}" Text="WHAT YOU NEED"/>
                  <TextBlock Style="{StaticResource Body}" Text="•  Minecraft: Java Edition (you need to own it) — Hivecraft uses version 1.21.1."/>
                  <TextBlock Style="{StaticResource Body}" Text="•  An AI account: a Claude subscription (Pro/Max), an Anthropic API key, an OpenRouter key or another compatible service."/>
                  <TextBlock Style="{StaticResource Body}" Text="•  About 2.5 GB of free disk space and an internet connection for setup."/>
                  <TextBlock Style="{StaticResource Body}" Text="•  A reasonably modern PC: the Minecraft server, the game and the agents run together (8 GB RAM or more recommended)."/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Style="{StaticResource Label}" Text="WHAT SETUP DOES"/>
                  <TextBlock Style="{StaticResource Body}" Text="Installs Hivecraft for your Windows user only (no admin rights). It downloads what Hivecraft needs from the official sources and checks every file: Node.js (nodejs.org), Java 21 (Eclipse Temurin, adoptium.net), the Minecraft 1.21.1 server (Mojang) and the Node packages (npmjs.com). Programs you already have in a suitable version are reused. Nothing else on your PC is changed."/>
                  <TextBlock Style="{StaticResource Help}" Text="Download size: about 350 MB (less if Node.js or Java are already installed). Everything can be removed again from Settings → Apps."/>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- MAINTENANCE -->
            <StackPanel x:Name="pMaint" Visibility="Collapsed">
              <TextBlock Style="{StaticResource H1}" Text="Hivecraft is already installed"/>
              <TextBlock x:Name="MaintLead" Style="{StaticResource Lead}" Text="Found in …"/>
              <RadioButton x:Name="mRepair" Style="{StaticResource Choice}" GroupName="maint" IsChecked="True">
                <StackPanel>
                  <TextBlock Text="Repair or update" FontSize="14" FontWeight="SemiBold"/>
                  <TextBlock Style="{StaticResource Help}" Text="Copies the Hivecraft files again, fixes missing downloads and lets you change the AI and player settings. Your worlds, the agents' memory and your settings are kept."/>
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="mUninstall" Style="{StaticResource Choice}" GroupName="maint">
                <StackPanel>
                  <TextBlock Text="Uninstall" FontSize="14" FontWeight="SemiBold"/>
                  <TextBlock Style="{StaticResource Help}" Text="Removes Hivecraft from this PC. You choose what happens to your worlds and the Minecraft profile on the next page."/>
                </StackPanel>
              </RadioButton>
            </StackPanel>

            <!-- FOLDER -->
            <StackPanel x:Name="pFolder" Visibility="Collapsed">
              <TextBlock Style="{StaticResource H1}" Text="Where should Hivecraft go?"/>
              <TextBlock Style="{StaticResource Lead}" Text="The default is fine for almost everyone. It is inside your user profile, so no admin rights are needed. Worlds and the agents' memory are stored here too."/>
              <TextBlock Style="{StaticResource Label}" Text="INSTALL FOLDER"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="DirBox" Style="{StaticResource Input}" TextChanged="DirBox_TextChanged"/>
                <Button Grid.Column="1" Style="{StaticResource Ghost}" Content="Browse…" Margin="8,0,0,0" Click="Browse_Click"/>
              </Grid>
              <TextBlock x:Name="DirInfo" Style="{StaticResource Help}" Text=""/>
              <Button Style="{StaticResource LinkBtn}" Content="Use the default folder" HorizontalAlignment="Left" Margin="0,10,0,0" Click="DefaultDir_Click"/>
            </StackPanel>

            <!-- MINECRAFT -->
            <StackPanel x:Name="pMinecraft" Visibility="Collapsed">
              <TextBlock Style="{StaticResource H1}" Text="Minecraft: Java Edition"/>
              <TextBlock Style="{StaticResource Lead}" Text="You play together with the agents in the normal Minecraft game. Hivecraft adds its own “Hivecraft” profile to your Minecraft Launcher the first time you press START; your other profiles and worlds are not touched."/>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="McDot" Width="10" Height="10" Fill="{StaticResource Faint}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="McTitle" Text="Checking…" Margin="10,0,0,0" FontSize="14" FontWeight="SemiBold"/>
                  </StackPanel>
                  <TextBlock x:Name="McDetail" Style="{StaticResource Help}" Text=""/>
                  <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Style="{StaticResource Ghost}" Content="Check again" Click="McRecheck_Click"/>
                    <Button Style="{StaticResource Ghost}" Content="Get Minecraft: Java Edition" Margin="8,0,0,0" Click="McGet_Click"/>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Style="{StaticResource Label}" Text="GOOD TO KNOW"/>
                  <TextBlock Style="{StaticResource Body}" Text="•  You need to own Minecraft: Java Edition (Bedrock / Pocket Edition will not work). Both the Minecraft Launcher from minecraft.net and the one from the Microsoft Store / Xbox app are fine."/>
                  <TextBlock Style="{StaticResource Body}" Text="•  Hivecraft uses Minecraft 1.21.1. The launcher downloads it by itself when you first press PLAY on the Hivecraft profile."/>
                  <TextBlock Style="{StaticResource Body}" Text="•  The server runs only on your PC (port 25590) and only accepts connections from this PC, so nobody else can join your world."/>
                  <TextBlock Style="{StaticResource Help}" Text="You can continue without Minecraft and install it later — the agents still play and you can watch them on the dashboard."/>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- DEPENDENCIES -->
            <StackPanel x:Name="pDeps" Visibility="Collapsed">
              <TextBlock Style="{StaticResource H1}" Text="Download and install"/>
              <TextBlock Style="{StaticResource Lead}" Text="Setup now gets everything Hivecraft needs and checks each file's checksum. If a download fails, press Retry — it continues where it stopped."/>
              <Border x:Name="EulaCard" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Style="{StaticResource Label}" Text="MINECRAFT EULA"/>
                  <TextBlock Style="{StaticResource Body}" Text="Hivecraft runs the official Minecraft server from Mojang on your PC. To run it you must agree to the Minecraft End User License Agreement."/>
                  <Button Style="{StaticResource LinkBtn}" Content="Read the Minecraft EULA (aka.ms/MinecraftEULA)" HorizontalAlignment="Left" Margin="0,8,0,4" Click="Eula_Click"/>
                  <CheckBox x:Name="EulaCheck" Style="{StaticResource Check}" Content="I have read and accept the Minecraft EULA" Checked="Eula_Changed" Unchecked="Eula_Changed"/>
                  <CheckBox x:Name="ReuseCheck" Style="{StaticResource Check}" IsChecked="True" Content="Reuse Node.js and Java if a suitable version is already installed"/>
                </StackPanel>
              </Border>
              <ItemsControl x:Name="StepList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{StaticResource Panel}" BorderBrush="{Binding Line}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,6">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Icon}" Foreground="{Binding IconFg}" FontSize="15" FontWeight="Bold" VerticalAlignment="Top" Margin="0,1,0,0"/>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{Binding DetailFg}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ProgressBar x:Name="DepBar" Style="{StaticResource Bar}" Minimum="0" Maximum="1" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- AI -->
            <StackPanel x:Name="pAI" Visibility="Collapsed">
              <TextBlock Style="{StaticResource H1}" Text="Connect an AI"/>
              <TextBlock Style="{StaticResource Lead}" Text="Every agent is a Claude Code session. Pick how it should reach an AI model. You can change this later in Hivecraft."/>
              <ItemsControl x:Name="KindList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <RadioButton Style="{StaticResource Choice}" GroupName="kind" IsChecked="{Binding Selected, Mode=TwoWay}" Tag="{Binding Kind}" Checked="Kind_Checked">
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Tagline}" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,2,0,0"/>
                      </StackPanel>
                    </RadioButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Style="{StaticResource Card}" Margin="0,6,0,12">
                <StackPanel>
                  <TextBlock x:Name="KindHelp" Style="{StaticResource Body}" Text=""/>
                  <Button x:Name="KindLink" Style="{StaticResource LinkBtn}" Content="" HorizontalAlignment="Left" Margin="0,8,0,0" Click="KindLink_Click"/>

                  <StackPanel x:Name="BaseUrlPanel" Margin="0,14,0,0">
                    <TextBlock Style="{StaticResource Label}" Text="BASE URL"/>
                    <TextBox x:Name="BaseUrlBox" Style="{StaticResource Input}"/>
                  </StackPanel>
                  <StackPanel x:Name="KeyPanel" Margin="0,14,0,0">
                    <TextBlock x:Name="KeyLabel" Style="{StaticResource Label}" Text="API KEY"/>
                    <PasswordBox x:Name="KeyBox" Style="{StaticResource Secret}"/>
                    <TextBlock x:Name="KeyNote" Style="{StaticResource Help}" Text="Stored encrypted for your Windows account only — never in a plain file."/>
                  </StackPanel>

                  <TextBlock Style="{StaticResource Label}" Text="MODEL" Margin="0,14,0,7"/>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ComboBox x:Name="ModelCombo" Style="{StaticResource Combo}" SelectionChanged="ModelCombo_SelectionChanged"/>
                    <TextBox x:Name="ModelBox" Grid.Column="2" Style="{StaticResource Input}" ToolTip="Model id (you can type any id your provider supports)"/>
                  </Grid>
                  <TextBlock x:Name="ModelNote" Style="{StaticResource Help}" Text=""/>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Style="{StaticResource Label}" Text="CLAUDE CODE"/>
                  <TextBlock x:Name="ClaudeStatus" Style="{StaticResource Body}" Text="Checking…"/>
                  <TextBlock Style="{StaticResource Help}" Text="Claude Code is Anthropic's official command-line tool. Hivecraft uses it to run each agent, whichever AI you pick. Installing it uses Anthropic's official installer (claude.ai/install.ps1) for your user only."/>
                  <WrapPanel Margin="0,12,0,0">
                    <Button x:Name="ClaudeInstallBtn" Style="{StaticResource Ghost}" Content="Install Claude Code" Margin="0,0,8,0" Click="ClaudeInstall_Click"/>
                    <Button x:Name="ClaudeLoginBtn" Style="{StaticResource Ghost}" Content="Sign in to Claude" Margin="0,0,8,0" Click="ClaudeLogin_Click"/>
                    <Button Style="{StaticResource Ghost}" Content="Check again" Margin="0,0,8,0" Click="ClaudeRecheck_Click"/>
                    <Button x:Name="TestBtn" Style="{StaticResource Ghost}" Content="Test connection" Click="Test_Click"/>
                  </WrapPanel>
                  <TextBlock x:Name="TestResult" Style="{StaticResource Help}" Text="Test connection sends one tiny request (costs a fraction of a cent on paid APIs)."/>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- PLAYER -->
            <StackPanel x:Name="pPlayer" Visibility="Collapsed">
              <TextBlock Style="{StaticResource H1}" Text="About you"/>
              <TextBlock Style="{StaticResource Lead}" Text="The agents need to know who you are in the game, so they can find you, follow you and answer you first."/>
              <TextBlock Style="{StaticResource Label}" Text="YOUR MINECRAFT USERNAME"/>
              <TextBox x:Name="McNameBox" Style="{StaticResource Input}" TextChanged="Player_TextChanged"/>
              <TextBlock x:Name="McNameNote" Style="{StaticResource Help}" Text="The name shown in-game (3–16 letters, digits or _). Your Minecraft Launcher signs you in as usual; the local server lets you in with this name."/>
              <TextBlock Style="{StaticResource Label}" Text="WHAT SHOULD THE AGENTS CALL YOU?" Margin="0,18,0,7"/>
              <TextBox x:Name="DisplayBox" Style="{StaticResource Input}" TextChanged="Player_TextChanged"/>
              <TextBlock Style="{StaticResource Help}" Text="Optional — a first name or nickname. Leave empty to use your Minecraft name."/>
            </StackPanel>

            <!-- SHORTCUTS -->
            <StackPanel x:Name="pShortcuts" Visibility="Collapsed">
              <TextBlock Style="{StaticResource H1}" Text="Shortcuts"/>
              <TextBlock Style="{StaticResource Lead}" Text="Where would you like to start Hivecraft from?"/>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <CheckBox x:Name="DeskCheck" Style="{StaticResource Check}" IsChecked="True" Content="Desktop shortcut"/>
                  <CheckBox x:Name="StartCheck" Style="{StaticResource Check}" IsChecked="True" Content="Start menu (Hivecraft + Uninstall Hivecraft)"/>
                  <TextBlock Style="{StaticResource Help}" Text="Hivecraft is always listed in Settings → Apps → Installed apps, where you can repair or uninstall it."/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Style="{StaticResource Label}" Text="SUMMARY"/>
                  <TextBlock x:Name="Summary" Style="{StaticResource Body}" Text=""/>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- FINISH -->
            <StackPanel x:Name="pFinish" Visibility="Collapsed">
              <TextBlock x:Name="FinishTitle" Style="{StaticResource H1}" Text="Finishing…"/>
              <TextBlock x:Name="FinishLead" Style="{StaticResource Lead}" Text="Saving your settings and adding shortcuts."/>
              <ItemsControl x:Name="FinishList"/>
              <Border x:Name="NextStepsCard" Style="{StaticResource Card}" Visibility="Collapsed">
                <StackPanel>
                  <TextBlock Style="{StaticResource Label}" Text="HOW TO PLAY"/>
                  <TextBlock Style="{StaticResource Body}" Text="1.  Open Hivecraft, name your agents and press START. It starts the server and the agents, then opens the Minecraft Launcher."/>
                  <TextBlock Style="{StaticResource Body}" Text="2.  In the launcher pick the “Hivecraft” profile and press PLAY — you join the world automatically."/>
                  <TextBlock Style="{StaticResource Body}" Text="3.  Tell the agents what to do in Minecraft chat, for example “build a house by the lake”."/>
                  <CheckBox x:Name="LaunchCheck" Style="{StaticResource Check}" IsChecked="True" Content="Open Hivecraft now" Margin="0,12,0,0"/>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- UNINSTALL -->
            <StackPanel x:Name="pUninstall" Visibility="Collapsed">
              <TextBlock Style="{StaticResource H1}" Text="Uninstall Hivecraft"/>
              <TextBlock x:Name="UnLead" Style="{StaticResource Lead}" Text=""/>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <CheckBox x:Name="UnKeepWorlds" Style="{StaticResource Check}" IsChecked="True" Content="Keep a copy of my worlds (saved to Documents\Hivecraft worlds backup …)"/>
                  <CheckBox x:Name="UnUserData" Style="{StaticResource Check}" IsChecked="True" Content="Remove saved API keys and Hivecraft settings"/>
                  <CheckBox x:Name="UnMcProfile" Style="{StaticResource Check}" IsChecked="False" Content="Also remove the Hivecraft profile from the Minecraft Launcher"/>
                  <TextBlock Style="{StaticResource Help}" Text="The last option removes only what Hivecraft added to Minecraft: the “Hivecraft” launcher profile, versions\hivecraft-1.21.1 and the .minecraft\hivecraft game folder (its mods and settings). Your other profiles and worlds are never touched."/>
                </StackPanel>
              </Border>
              <ItemsControl x:Name="UnLog">
                <ItemsControl.ItemTemplate>
                  <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Body}" Margin="0,2"/></DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </Grid>

      <!-- bottom bar -->
      <Border Grid.Row="2" Background="#0C1017" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="18,12">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
            <TextBlock x:Name="StatusText" Text="" FontSize="12" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="ErrorText" Text="" FontSize="12" Foreground="{StaticResource Red}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,3,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="LogBtn" Style="{StaticResource Ghost}" Content="Open log" Margin="0,0,8,0" Click="Log_Click"/>
            <Button x:Name="BackBtn" Style="{StaticResource Ghost}" Content="Back" Width="90" Margin="0,0,8,0" Click="Back_Click"/>
            <Button x:Name="RetryBtn" Style="{StaticResource Ghost}" Content="Retry" Width="90" Margin="0,0,8,0" Visibility="Collapsed" Click="Retry_Click"/>
            <Button x:Name="NextBtn" Style="{StaticResource Primary}" Content="Next" Width="150" Height="38" Click="Next_Click"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
