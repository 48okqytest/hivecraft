<Project Sdk="Microsoft.NET.Sdk">
  <!-- Hivecraft-Setup.exe: per-user installer (no admin). Payload: -p:PayloadZip=<abs path to payload.zip> embeds it
       as resource "payload.zip"; without it the exe looks for Hivecraft-payload.zip next to itself (or -\-payload <zip>). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Hivecraft-Setup</AssemblyName>
    <RootNamespace>Hivecraft.Setup</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\launcher\hive.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Hivecraft</Product>
    <Company>Hivecraft</Company>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableDefaultPageItems>true</EnableDefaultPageItems>
  </PropertyGroup>
  <ItemGroup>
    <Page Include="..\launcher\Styles.xaml" Link="Styles.xaml" />
    <Resource Include="..\launcher\hive.ico" Link="hive.ico" />
    <Resource Include="..\launcher\hive.png" Link="hive.png" />
    <Compile Include="..\launcher\Core\HiveConfig.cs" Link="Shared\HiveConfig.cs" />
    <Compile Include="..\launcher\Core\Providers.cs" Link="Shared\Providers.cs" />
    <Compile Include="..\launcher\Core\FileEdits.cs" Link="Shared\FileEdits.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(PayloadZip)' != ''">
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="payload.zip" />
  </ItemGroup>
</Project>
